# Required
POSTBOX_DATABASE_URL=sqlite+aiosqlite:////data/postbox.db
POSTBOX_JWT_SECRET_KEY=replace-with-openssl-rand-hex-32

# Hub Bot handoff. Leave empty to disable Hub authentication.
HUB_AUTH_SECRET=
HUB_BOT_URL=

# App settings
POSTBOX_REGISTRATION_LIMIT=5
POSTBOX_LOG_LEVEL=INFO

# Static asset versioning (cache-busting): appended to CSS/JS URLs as ?v=<version>
# Defaults to git SHA if not set. For production, set to release version or git commit.
POSTBOX_STATIC_VERSION=

# Cookies must be secure in production HTTPS.
POSTBOX_COOKIE_SECURE=true

# Local development only.
POSTBOX_DEV_LOGIN=false
POSTBOX_API_HOST=127.0.0.1
POSTBOX_API_PORT=8000
POSTBOX_API_RELOAD=false
